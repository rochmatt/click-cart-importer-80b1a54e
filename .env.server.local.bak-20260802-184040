# Secret runtime server-side — TIDAK ikut ke git, TIDAK masuk bundle browser.
# Dibaca proses Node saat runtime (bukan saat build).
#
# Cara isi: ganti nilai GANTI_SAYA lalu jalankan `pm2 restart inipilihanku`.

# --- Email (Resend) -------------------------------------------------------
# API key dari https://resend.com/api-keys (berawalan re_).
# Tanpa ini situs tetap jalan normal; hanya pengiriman email yang gagal.
RESEND_API_KEY=GANTI_SAYA_RESEND_API_KEY

# Alamat pengirim. Domainnya WAJIB sudah diverifikasi di Resend
# (Domains → Add Domain → notify.inipilihanku.com), kalau belum setiap
# kiriman ditolak 403.
# Dikutip: tanpa kutip, tanda < dibaca bash sebagai redirect saat file di-source.
EMAIL_FROM="PasarPilih <noreply@notify.inipilihanku.com>"

# Secret Send Email Hook dari Supabase Dashboard → Authentication → Hooks.
# Bentuknya v1,whsec_<base64>. Salin apa adanya, termasuk prefiksnya.
SEND_EMAIL_HOOK_SECRET=GANTI_SAYA_HOOK_SECRET

# --- Supabase -------------------------------------------------------------
# Untuk operasi admin yang bypass RLS (src/integrations/supabase/client.server.ts).
# Supabase → Project Settings → API Keys → secret key (berawalan sb_secret_).
SUPABASE_SERVICE_ROLE_KEY=GANTI_SAYA_SERVICE_ROLE_KEY

# --- Umum -----------------------------------------------------------------
# Base URL untuk link di email transaksional dan canonical URL.
SITE_URL=https://inipilihanku.com

# Port & host proses SSR. nginx mem-proxy ke sini.
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# --- PostgreSQL lokal (pengganti Supabase, migrasi sedang berjalan) --------
# Belum dipakai aplikasi. Lapisan data masih menunjuk Supabase sampai
# Fase 2-5 selesai. Lihat db/schema.sql untuk penjelasan dua role di bawah.

# Pemilik tabel — MELEWATI RLS. Untuk operasi service/admin (setara service_role).
DATABASE_URL=postgresql://inipilihanku:arijaXElBtI6fvzwDbDuvRN6ftcwS1j@127.0.0.1:5432/inipilihanku

# Tunduk pada RLS. Untuk query atas nama pengguna; lapisan data WAJIB
# menjalankan SET LOCAL app.user_id sebelum query apa pun.
DATABASE_URL_APP=postgresql://inipilihanku_app:eiz2lVxX4Lnmv0bqRIvkomy3sveojcsj@127.0.0.1:5432/inipilihanku

# --- Proxy ----------------------------------------------------------------
# Mengizinkan aplikasi memercayai X-Forwarded-Proto dari nginx. Aman di sini
# karena nginx MENIMPA header itu (proxy_set_header X-Forwarded-Proto $scheme),
# jadi klien tidak bisa memalsukannya. Jangan aktifkan di lingkungan yang
# proxy-nya meneruskan nilai dari klien apa adanya.
#
# Tanpa ini, metadata OAuth MCP mengumumkan resource sebagai http:// dan klien
# MCP gagal 401 karena resource indicator dicocokkan sebagai string persis.
TRUST_PROXY_PROTO=1
